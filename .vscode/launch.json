{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "gdb-stm8",
            "type": "gdb",
            "request": "attach",
            "executable": "${workspaceRoot}/out.elf",
            "gdbpath": "stm8-gdb",
            "remote": true,
            "target": ":3333",
            "cwd": "${workspaceRoot}",
            "autorun": [
            ]
        },
        {
            "type": "stm8-debug",
            "request": "launch",
            "name": "stm8-debug",
            "serverType": "stm8-sdcc",
            "executable": "${workspaceRoot}/out.elf",
            "openOcdConfigs": [
                "interface/stlink-dap.cfg",
                "target/stm8s.cfg"
            ]
        }
    ]
}
