{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "stm8: build",
            "type": "shell",
            "command": "make debug-files",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "sdcc",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(?:\\u001b\\[[0-9;]*m)*(.+?)(?:\\u001b\\[[0-9;]*m)*:(\\d+)(?:\\u001b\\[[0-9;]*m)*:\\s*(?:\\u001b\\[[0-9;]*m)*\\s*(warning|error)\\s+(\\d+):(?:\\u001b\\[[0-9;]*m)*\\s*(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "code": 4,
                    "message": 5
                }
            }
        }
    ]
}
